# ATENÇÃO — estes itens PRECISAM ir para o Git (a Hostinger só puxa o repositório):
#   assets/css/main.css        (gerado por "npm run build")
#   assets/vendor/             (Swiper, copiado por "npm install")
#   assets/fonts/*.woff2       (fontes locais)
#   vendor/                    (Carbon Fields, "composer install --no-dev")
#   package-lock.json e composer.lock
